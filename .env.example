# Supabase → Project Settings → API.
# Use the project URL, not the /rest/v1 path. The anon or publishable key is public.
# Never put the service_role or secret key in a VITE_ variable. Vite would ship it
# to the browser. The seed script reads the secret from this file in Node only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
